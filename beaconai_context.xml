13: class AppBlocObserver extends BlocObserver {
14:   const AppBlocObserver();
15: 
16:   @override
17:   void onChange(BlocBase<dynamic> bloc, Change<dynamic> change) {
18:     super.onChange(bloc, change);
19:     log('onChange(${bloc.runtimeType}, $change)');
20:   }
21: 
22:   @override
23:   void onError(BlocBase<dynamic> bloc, Object error, StackTrace stackTrace) {
24:     log('onError(${bloc.runtimeType}, $error, $stackTrace)');
25:     super.onError(bloc, error, stackTrace);
26:   }
27: }
28: 
29: Future<void> bootstrap(FutureOr<Widget> Function(AssistantRepository) builder) async {
30:   FlutterError.onError = (details) {
31:     log(details.exceptionAsString(), stackTrace: details.stack);
32:   };
33: 
34:   Bloc.observer = const AppBlocObserver();
35: 
36:   const geminiApiKey = String.fromEnvironment('GEMINI_API_KEY');
37: 
38:   if (geminiApiKey.isEmpty) {
39:     throw Exception(
40:       'GEMINI_API_KEY is missing! Please run the app with --dart-define-from-file=.env',
41:     );
42:   }
43: 
44:   final aiClient = AiAgentClient(apiKey: geminiApiKey);
45:   final processManager = OsProcessManager();
46:   final keyboardController = KeyboardController();
47:   final ttsService = TtsService();
48:   final sttService = SttService();
49: 
50:   final repository = AssistantRepository(
51:     aiClient: aiClient,
52:     processManager: processManager,
53:     keyboardController: keyboardController,
54:     ttsService: ttsService,
55:     sttService: sttService,
56:   );
57: 
58:   runApp(await builder(repository));
59: }
</file>

