<file path="lib/voice_assistant/cubit/voice_assistant_cubit.dart">
 1: // lib/voice_assistant/cubit/voice_assistant_cubit.dart
 2: 
 3: import 'package:bloc/bloc.dart';
 4: import 'package:assistant_repository/assistant_repository.dart';
 5: import 'package:path_provider/path_provider.dart';
 6: import 'dart:io';
 7: import 'voice_assistant_state.dart';
 8: 
 9: class VoiceAssistantCubit extends Cubit<VoiceAssistantState> {
10:   VoiceAssistantCubit({required AssistantRepository repository})
11:       : _repository = repository,
12:         super(const VoiceAssistantState());
13: 
14:   final AssistantRepository _repository;
15: 
16:   /// دالة لمعالجة النص المكتوب
17:   Future<void> submitCommand(String command) async {
18:     if (command.trim().isEmpty) return;
19:     await _execute(command);
20:   }
21: 
22:   /// دالة لبدء تسجيل الصوت
23:   Future<void> startListening() async {
24:     try {
25:       emit(state.copyWith(status: AssistantStatus.listening));
26:       
27:       // تحديد مسار حفظ الملف الصوتي المؤقت
28:       final dir = await getTemporaryDirectory();
29:       final path = '${dir.path}/command.m4a';
30:       
31:       await _repository.sttService.startRecording(path);
32:     } catch (e) {
33:       emit(state.copyWith(
34:         status: AssistantStatus.error,
35:         errorMessage: 'فشل الوصول للميكروفون: $e',
36:       ));
37:     }
38:   }
39: 
40:   /// دالة إيقاف التسجيل ومعالجته
41:   Future<void> stopListening() async {
42:     try {
43:       emit(state.copyWith(status: AssistantStatus.thinking));
44:       
45:       final audioPath = await _repository.sttService.stopRecording();
46:       if (audioPath != null) {
47:         // هنا مستقبلاً سنقوم بإرسال الملف الصوتي لـ Gemini أو تحويله لنص
48:         // حالياً سنضع رسالة مؤقتة لتأكيد نجاح التسجيل
49:         print("تم حفظ التسجيل في: $audioPath");
50:         
51:         await _repository.speak('تم استلام رسالتك الصوتية، جاري معالجتها قريباً.');
52:         emit(state.copyWith(status: AssistantStatus.idle));
53:       } else {
54:         emit(state.copyWith(status: AssistantStatus.idle));
55:       }
56:     } catch (e) {
57:       emit(state.copyWith(
58:         status: AssistantStatus.error,
59:         errorMessage: 'حدث خطأ أثناء إيقاف التسجيل: $e',
60:       ));
61:     }
62:   }
63: 
64:   /// دالة مركزية للتنفيذ
65:   Future<void> _execute(String command) async {
66:     try {
67:       emit(state.copyWith(status: AssistantStatus.thinking));
68:       await _repository.executeTextCommand(command);
69:       emit(state.copyWith(status: AssistantStatus.idle));
70:     } catch (e) {
71:       emit(state.copyWith(
72:         status: AssistantStatus.error,
73:         errorMessage: e.toString(),
74:       ));
75:     }
76:   }
77: 
78:   Future<void> testSpeech(String text) async {
79:     emit(state.copyWith(status: AssistantStatus.speaking));
80:     await _repository.speak(text);
81:     emit(state.copyWith(status: AssistantStatus.idle));
82:   }
83: }
</file>

