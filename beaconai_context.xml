<file path="packages/ai_agent_api/lib/src/ai_agent_client.dart">
 1: // packages/ai_agent_api/lib/src/ai_agent_client.dart
 2: 
 3: import 'package:google_generative_ai/google_generative_ai.dart';
 4: import 'models/agent_action.dart';
 5: 
 6: class AiAgentClient {
 7:   AiAgentClient({required String apiKey}) {
 8:     // إعداد النموذج مع تعريف الأدوات التي يمكنه استخدامها
 9:     _model = GenerativeModel(
10:       model: 'gemini-1.5-flash',
11:       apiKey: apiKey,
12:       tools: [_buildTools()],
13:       systemInstruction: Content.system(
14:         'أنت مساعد ذكي مخصص لمساعدة المكفوفين وضعاف البصر في استخدام نظام ويندوز. '
15:         'مهمتك هي تحليل طلب المستخدم واستخدام الأدوات (Tools) المتاحة لك لتنفيذ المهام المطلوبة خطوة بخطوة. '
16:         'لا تقم بالشرح الطويل، فقط نفذ الأدوات المناسبة بالترتيب.',
17:       ),
18:     );
19:   }
20: 
21:   late final GenerativeModel _model;
22: 
23:   /// تعريف الأدوات (Functions) التي سنرسلها للذكاء الاصطناعي
24:   static Tool _buildTools() {
25:     return Tool(functionDeclarations: [
26:       FunctionDeclaration(
27:         'open_app',
28:         'يفتح برنامجاً أو تطبيقاً على اللابتوب.',
29:         Schema(SchemaType.object, properties: {
30:           'app_name': Schema(SchemaType.string, description: 'اسم البرنامج بالإنجليزية (مثل notepad, msedge, calc)'),
31:         }, requiredProperties: ['app_name']),
32:       ),
33:       FunctionDeclaration(
34:         'type_text',
35:         'يكتب نصاً باستخدام لوحة المفاتيح.',
36:         Schema(SchemaType.object, properties: {
37:           'text': Schema(SchemaType.string, description: 'النص المراد كتابته'),
38:         }, requiredProperties: ['text']),
39:       ),
40:       FunctionDeclaration(
41:         'press_key',
42:         'يضغط على زر معين في لوحة المفاتيح.',
43:         Schema(SchemaType.object, properties: {
44:           'key_name': Schema(SchemaType.string, description: 'اسم الزر (مثل: enter, tab, windows)'),
45:         }, requiredProperties: ['key_name']),
46:       ),
47:     ]);
48:   }
49: 
50:   /// إرسال أمر المستخدم للذكاء الاصطناعي واستقبال قائمة الأفعال (Actions)
51:   Future<List<AgentAction>> processUserCommand(String prompt) async {
52:     final chat = _model.startChat();
53:     final response = await chat.sendMessage(Content.text(prompt));
54: 
55:     final actions = <AgentAction>[];
56: 
57:     // التحقق مما إذا كان النموذج قرر استدعاء أدوات معينة
58:     final functionCalls = response.functionCalls.toList();
59:     
60:     for (final call in functionCalls) {
61:       switch (call.name) {
62:         case 'open_app':
63:           actions.add(AgentAction(
64:             type: ActionType.openApp,
65:             parameters: call.args,
66:           ));
67:           break;
68:         case 'type_text':
69:           actions.add(AgentAction(
70:             type: ActionType.typeText,
71:             parameters: call.args,
72:           ));
73:           break;
74:         case 'press_key':
75:           actions.add(AgentAction(
76:             type: ActionType.pressKey,
77:             parameters: call.args,
78:           ));
79:           break;
80:         default:
81:           actions.add(AgentAction(
82:             type: ActionType.unknown,
83:             parameters: call.args,
84:           ));
85:       }
86:     }
87: 
88:     return actions;
89:   }
90: }
</file>

