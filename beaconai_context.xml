<file path="packages/os_automation_api/lib/src/keyboard_controller.dart">
 1: // packages/os_automation_api/lib/src/keyboard_controller.dart
 2: 
 3: import 'dart:ffi';
 4: import 'package:ffi/ffi.dart';
 5: import 'package:win32/win32.dart';
 6: 
 7: class KeyboardController {
 8:   /// محاكاة كتابة نص كامل (يدعم العربية والإنجليزية)
 9:   void typeText(String text) {
10:     for (var i = 0; i < text.length; i++) {
11:       final charCode = text.codeUnitAt(i);
12:       _sendUnicodeChar(charCode);
13:     }
14:   }
15: 
16:   /// محاكاة الضغط على زر الإدخال (Enter)
17:   void pressEnter() {
18:     _sendVirtualKey(VK_RETURN);
19:   }
20: 
21:   /// محاكاة الضغط على زر المسافة (Tab)
22:   void pressTab() {
23:     _sendVirtualKey(VK_TAB);
24:   }
25:   
26:   /// محاكاة الضغط على زر الويندوز (Windows Key)
27:   void pressWindowsKey() {
28:     _sendVirtualKey(VK_LWIN);
29:   }
30: 
31:   /// دالة داخلية لإرسال أحرف النصوص باستخدام تقنية Unicode
32:   void _sendUnicodeChar(int charCode) {
33:     final inputs = calloc<INPUT>(2);
34: 
35:     // حدث ضغط الزر (Key Down)
36:     inputs[0].type = INPUT_KEYBOARD;
37:     inputs[0].ki.wScan = charCode;
38:     inputs[0].ki.dwFlags = KEYEVENTF_UNICODE;
39: 
40:     // حدث إفلات الزر (Key Up)
41:     inputs[1].type = INPUT_KEYBOARD;
42:     inputs[1].ki.wScan = charCode;
43:     inputs[1].ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
44: 
45:     SendInput(2, inputs, sizeOf<INPUT>());
46:     free(inputs);
47:   }
48: 
49:   /// دالة داخلية للضغط على أزرار النظام (Virtual Keys)
50:   /// لاحظ أننا نمرر VIRTUAL_KEY بدلاً من int
51:   void _sendVirtualKey(VIRTUAL_KEY keyCode) {
52:     final inputs = calloc<INPUT>(2);
53: 
54:     // Key Down
55:     inputs[0].type = INPUT_KEYBOARD;
56:     inputs[0].ki.wVk = keyCode;
57: 
58:     // Key Up
59:     inputs[1].type = INPUT_KEYBOARD;
60:     inputs[1].ki.wVk = keyCode;
61:     inputs[1].ki.dwFlags = KEYEVENTF_KEYUP;
62: 
63:     SendInput(2, inputs, sizeOf<INPUT>());
64:     free(inputs);
65:   }
66: }
</file>

<file path="packages/os_automation_api/lib/src/process_manager.dart">
 1: // packages/os_automation_api/lib/src/process_manager.dart
 2: 
 3: import 'dart:io';
 4: 
 5: class OsProcessManager {
 6:   /// يفتح برنامجاً معيناً موجوداً في النظام (مثل: notepad, msedge, calc)
 7:   Future<void> launchApp(String executableName, {List<String> arguments = const []}) async {
 8:     try {
 9:       // نستخدم runInShell لكي يتعرف النظام على مسارات البرامج الافتراضية
10:       await Process.start(executableName, arguments, runInShell: true);
11:     } catch (e) {
12:       throw Exception('فشل في تشغيل البرنامج: $executableName. التفاصيل: $e');
13:     }
14:   }
15: 
16:   /// يفتح موقعاً إلكترونياً باستخدام المتصفح الافتراضي للنظام
17:   Future<void> openUrl(String url) async {
18:     try {
19:       // أمر 'start' في ويندوز يقوم بفتح الروابط بالمتصفح الافتراضي
20:       await Process.run('cmd', ['/c', 'start', url], runInShell: true);
21:     } catch (e) {
22:       throw Exception('فشل في فتح الرابط: $url');
23:     }
24:   }
25: }
