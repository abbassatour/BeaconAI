<file path="packages/speech_api/lib/src/stt/stt_service.dart">
 1: // packages/speech_api/lib/src/stt/stt_service.dart
 2: 
 3: import 'package:record/record.dart';
 4: 
 5: class SttService {
 6:   SttService({AudioRecorder? audioRecorder}) : _audioRecorder = audioRecorder ?? AudioRecorder();
 7: 
 8:   final AudioRecorder _audioRecorder;
 9: 
10:   /// التحقق من صلاحيات الميكروفون
11:   Future<bool> hasPermission() async {
12:     return await _audioRecorder.hasPermission();
13:   }
14: 
15:   /// بدء تسجيل صوت المستخدم وحفظه في مسار محدد
16:   Future<void> startRecording(String path) async {
17:     if (await hasPermission()) {
18:       // إعدادات التسجيل بصيغة M4A وجودة مناسبة لتحليل الذكاء الاصطناعي
19:       const config = RecordConfig(
20:         encoder: AudioEncoder.aacLc,
21:         sampleRate: 16000,
22:         numChannels: 1,
23:       );
24:       await _audioRecorder.start(config, path: path);
25:     } else {
26:       throw Exception('Microphone permission not granted');
27:     }
28:   }
29: 
30:   /// إيقاف التسجيل وإرجاع مسار الملف الصوتي
31:   Future<String?> stopRecording() async {
32:     if (await _audioRecorder.isRecording()) {
33:       return await _audioRecorder.stop();
34:     }
35:     return null;
36:   }
37:   
38:   /// التخلص من الكائنات بالذاكرة عند إغلاق التطبيق
39:   void dispose() {
40:     _audioRecorder.dispose();
41:   }
42: }
</file>

