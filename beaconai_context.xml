<file path="packages/assistant_repository/lib/src/assistant_repository.dart">
 1: // packages/assistant_repository/lib/src/assistant_repository.dart
 2: 
 3: import 'package:ai_agent_api/ai_agent_api.dart';
 4: import 'package:os_automation_api/os_automation_api.dart';
 5: import 'package:speech_api/speech_api.dart';
 6: 
 7: class AssistantRepository {
 8:   AssistantRepository({
 9:     required AiAgentClient aiClient,
10:     required OsProcessManager processManager,
11:     required KeyboardController keyboardController,
12:     required TtsService ttsService,
13:     required SttService sttService,
14:   })  : _aiClient = aiClient,
15:         _processManager = processManager,
16:         _keyboardController = keyboardController,
17:         _ttsService = ttsService,
18:         _sttService = sttService;
19: 
20:   final AiAgentClient _aiClient;
21:   final OsProcessManager _processManager;
22:   final KeyboardController _keyboardController;
23:   final TtsService _ttsService;
24:   final SttService _sttService;
25: 
26:   // 👉 هنا قمنا بإضافة Getters للسماح للـ Cubit بالوصول للخدمات الصوتية 
27:   SttService get sttService => _sttService;
28:   TtsService get ttsService => _ttsService;
29: 
30:   /// دالة التحدث مع المستخدم
31:   Future<void> speak(String text) async {
32:     await _ttsService.speak(text);
33:   }
34: 
35:   /// الدالة الرئيسية التي تأخذ طلب المستخدم (كنص حالياً) وتنفذه بالكامل
36:   Future<void> executeTextCommand(String command) async {
37:     try {
38:       // 1. إخبار المستخدم أننا نفكر
39:       await speak('جاري تنفيذ طلبك، لحظات من فضلك.');
40: 
41:       // 2. إرسال الطلب للدماغ (Gemini AI)
42:       final actions = await _aiClient.processUserCommand(command);
43: 
44:       // 3. تنفيذ الأفعال بالترتيب (اليدين)
45:       for (final action in actions) {
46:         await _executeAction(action);
47:         // تأخير بسيط بين كل حركة وأخرى لكي يستوعب نظام التشغيل
48:         await Future.delayed(const Duration(milliseconds: 500));
49:       }
50: 
51:       // 4. إخبار المستخدم بنجاح المهمة
52:       await speak('تم التنفيذ بنجاح.');
53: 
54:     } catch (e) {
55:       await speak('عذراً، واجهت مشكلة أثناء التنفيذ.');
56:       print('Error executing command: $e');
57:     }
58:   }
59: 
60:   /// دالة داخلية لترجمة أمر الذكاء الاصطناعي إلى حركة فعلية على الويندوز
61:   Future<void> _executeAction(AgentAction action) async {
62:     switch (action.type) {
63:       case ActionType.openApp:
64:         final appName = action.parameters['app_name'] as String?;
65:         if (appName != null) {
66:           await _processManager.launchApp(appName);
67:           // ننتظر قليلاً حتى يفتح البرنامج
68:           await Future.delayed(const Duration(seconds: 2));
69:         }
70:         break;
71: 
72:       case ActionType.typeText:
73:         final text = action.parameters['text'] as String?;
74:         if (text != null) {
75:           _keyboardController.typeText(text);
76:         }
77:         break;
78: 
79:       case ActionType.pressKey:
80:         final keyName = (action.parameters['key_name'] as String?)?.toLowerCase();
81:         if (keyName == 'enter') {
82:           _keyboardController.pressEnter();
83:         } else if (keyName == 'tab') {
84:           _keyboardController.pressTab();
85:         } else if (keyName == 'windows') {
86:           _keyboardController.pressWindowsKey();
87:         }
88:         break;
89: 
90:       case ActionType.unknown:
91:       default:
92:         print('إجراء غير معروف: ${action.parameters}');
93:     }
94:   }
95: }
</file>

